# Banco onde ficam os interessados (Supabase do Ultra-hero, tabela public.launch_leads).
SUPABASE_URL=https://cjcvlfypjoxaynwtmuhz.supabase.co
# Chave PÚBLICA (publishable). Só consegue chamar a função groscove_join_launch_list.
# Nunca usar a service_role aqui.
SUPABASE_PUBLISHABLE_KEY=
# Texto aleatório para guardar o IP só como hash. Gerar com: openssl rand -base64 32
IP_HASH_SALT=
# Opcional: data/hora do lançamento em ISO UTC (padrão 2027-01-01T03:00:00Z)
LAUNCH_AT=
